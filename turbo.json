{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.json", "patches/**"],
  "futureFlags": {
    "pruneIncludesGlobalFiles": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "build/**", "dist/**", "out/**"]
    }
  }
}
