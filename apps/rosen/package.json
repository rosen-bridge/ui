{
  "name": "@rosen-bridge/rosen-app",
  "version": "5.7.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/ui.git"
  },
  "license": "MIT",
  "scripts": {
    "bootstrap": "turbo build --filter=@rosen-bridge/rosen-app^...",
    "build": "next build",
    "build:vercel": "npm run bootstrap && npm run generate && npm run validate-token-icons && npm run db:migration && npm run build",
    "coverage": "npm run test -- --run --coverage",
    "db:migration": "node --import tsx ./scripts/migration.js",
    "dev": "next dev",
    "generate": "node ./configs/generate.mjs",
    "get-config": "npx @rosen-bridge/cli download-assets --chain-type public-launch --out configs --include-prereleases && npm run generate",
    "lint": "biome check --write",
    "lint:check": "biome check",
    "start": "next start",
    "test": "NODE_OPTIONS='--import tsx' vitest",
    "type-check": "tsc --noEmit",
    "validate-token-icons": "tsx ./scripts/validateTokenIcons"
  },
  "dependencies": {
    "@rosen-bridge/abstract-observation-extractor": "^1.0.10",
    "@rosen-bridge/abstract-scanner": "^2.0.3",
    "@rosen-bridge/encryption": "^1.0.1",
    "@rosen-bridge/extended-typeorm": "^1.1.0",
    "@rosen-bridge/icons": "^4.0.0",
    "@rosen-bridge/query-params": "^0.1.0",
    "@rosen-bridge/token-icons": "^0.1.0",
    "@rosen-bridge/token-price-entity": "^0.2.2",
    "@rosen-bridge/tokens": "^6.0.2",
    "@rosen-bridge/ui-kit": "^6.0.0",
    "@rosen-bridge/watcher-data-extractor": "^13.0.10",
    "@rosen-network/base": "^0.5.4",
    "@rosen-network/binance": "^0.4.9",
    "@rosen-network/bitcoin": "^2.4.8",
    "@rosen-network/bitcoin-runes": "^1.0.8",
    "@rosen-network/cardano": "^2.5.8",
    "@rosen-network/doge": "^0.4.8",
    "@rosen-network/ergo": "^2.5.9",
    "@rosen-network/ethereum": "^0.4.9",
    "@rosen-network/evm": "^0.3.8",
    "@rosen-network/firo": "^0.1.2",
    "@rosen-network/handshake": "^0.0.0",
    "@rosen-ui/asset-calculator": "^2.4.0",
    "@rosen-ui/constants": "^1.1.0",
    "@rosen-ui/data-source": "^0.3.0",
    "@rosen-ui/eternl-wallet": "^3.1.10",
    "@rosen-ui/firo-wallet": "^0.1.2",
    "@rosen-ui/lace-wallet": "^3.1.10",
    "@rosen-ui/metamask-wallet": "^2.2.3",
    "@rosen-ui/my-doge-wallet": "^1.1.12",
    "@rosen-ui/nautilus-wallet": "^3.1.10",
    "@rosen-ui/okx-wallet": "^2.2.5",
    "@rosen-ui/public-status": "^0.3.0",
    "@rosen-ui/shake-wallet": "^0.0.0",
    "@rosen-ui/swr-helpers": "^0.2.2",
    "@rosen-ui/types": "^0.5.1",
    "@rosen-ui/utils": "^1.0.4",
    "@rosen-ui/wallet-api": "^3.2.1",
    "@rosen-ui/wallet-connect": "^0.3.3",
    "@rosen-ui/xverse-wallet": "^0.5.3",
    "@sentry/nextjs": "^10.53.1",
    "@upstash/ratelimit": "^1.2.1",
    "@vercel/functions": "^3.4.2",
    "@vercel/kv": "^3.0.0",
    "joi": "^17.11.0",
    "next": "^16.3.2",
    "pg": "^8.11.3",
    "react": "^19.2.6",
